---
import Layout from "../layouts/Layout.astro";
import Landing from "../components/sections/Landing.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import ProjectRedis from "../components/sections/ProjectRedis.astro";
import ProjectPortfolio from "../components/sections/ProjectPortfolio.astro";
import Footer from "../components/sections/Footer.astro";
---
<Layout>
    <!-- TODO: <Menu client:load /> — overhead menu island (dark mode, music, volume) -->
    <Landing />
    <section id="bodySection" class="flex flex-col bg-linear-to-b from-[var(--bg-color)] to-[var(--accent-color)] text-[var(--txt-color)] min-h-screen">
        <AboutMe />
        <!-- TODO: <Toybox client:visible /> — chat + canvas island -->
        <ProjectRedis />
        <ProjectPortfolio />
    </section>
    <Footer />
</Layout>
