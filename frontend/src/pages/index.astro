---
import Layout from "../layouts/Layout.astro";
import Landing from "../components/sections/Landing.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import ProjectRedis from "../components/sections/ProjectRedis.astro";
import ProjectPortfolio from "../components/sections/ProjectPortfolio.astro";
import Footer from "../components/sections/Footer.astro";
import Menu from "../components/react/Menu";
import Toybox from "../components/react/Toybox";
---
<Layout>
    <Menu client:load />
    <Landing />
    <section id="bodySection" class="flex flex-col text-[var(--txt-color)] min-h-screen relative">
        <div class="lava-lamp-bg" aria-hidden="true">
            <div class="lava-lamp-blobs"></div>
        </div>
        <AboutMe />
        <!-- client:visible so the chat and canvas hubs only connect once the
             section is actually reached; Astro still renders the tiles into the
             HTML, which is what smoothScroll.ts needs on load -->
        <Toybox client:visible />
        <ProjectRedis />
        <ProjectPortfolio />
    </section>
    <Footer />
</Layout>
