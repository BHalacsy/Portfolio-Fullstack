<section id="landingPage">
    <div class="text-[var(--accent-color)] text-6xl max-[1050px]:text-4xl font-extrabold text-center mt-28 snap-start motion-preset-fade motion-duration-5000 font-titles">
        Welcome to my page!
    </div>
    <div class="text-center mt-10">
        <!-- TODO: replace with <ViewCounter client:load /> island once built -->
        <span id="viewCounter" class="text-3xl max-[1050px]:text-2xl text-[var(--txt-color)] font-semibold">You are visitor number:<br>
