            <img src="/media/darkArrow.svg" alt="arrow down" class="w-28 h-auto max-[1050px]:w-20 motion-preset-oscillate hidden dark:block">
        </a>
    </div>
    <img src="/media/lightLanding.svg" alt="landing page screen" class="w-screen block dark:hidden">
    <img src="/media/darkLanding.svg" alt="landing page screen" class="w-screen hidden dark:block">
