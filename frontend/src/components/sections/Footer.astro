---
const socials = [
    { href: "https://github.com/BHalacsy", src: "/media/icons/socials/githubIcon.svg", alt: "GitHub" },
    { href: "https://www.linkedin.com/in/balint-halacsy-18b05a2a9", src: "/media/icons/socials/linkedInIcon.svg", alt: "LinkedIn" },
    { href: "mailto:balint@halacsy.com", src: "/media/icons/socials/emailIcon.svg", alt: "Email" },
];
---
<section id="footerSection" class="bg-[var(--fg-color)] text-[var(--txt-color)] py-8 snap-start">
    <div class="flex flex-col items-center">
        <a href="#landingPage" class="mb-4 hover:scale-110 transition">
            <img src="/media/lightArrow.svg" alt="Back to top" class="w-10 h-10 rotate-180 dark:hidden">
            <img src="/media/darkArrow.svg" alt="Back to top" class="w-10 h-10 rotate-180 hidden dark:block">
        </a>
        <div class="flex space-x-6 mb-4">
            {socials.map((social) => (
                <a href={social.href} target={social.href.startsWith("mailto:") ? undefined : "_blank"} rel="noopener">
                    <img src={social.src} alt={social.alt} class="w-8 h-8 hover:scale-110 transition">
                </a>
            ))}
        </div>
        <div class="text-sm text-center">
            &copy; 2025 Bálint Halácsy's portfolio website
        </div>
    </div>
</section>
